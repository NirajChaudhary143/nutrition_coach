{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"title": "Rose",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "ink",         "name": "Ink",         "color": "#1C0A10" },
				{ "slug": "ink-2",       "name": "Ink Soft",    "color": "#3D1520" },
				{ "slug": "muted",       "name": "Muted",       "color": "#9A6070" },
				{ "slug": "rule",        "name": "Rule",        "color": "#F5D0DC" },
				{ "slug": "surface",     "name": "Surface",     "color": "#FFF1F5" },
				{ "slug": "base",        "name": "Base",        "color": "#FFF8FA" },
				{ "slug": "accent",      "name": "Accent",      "color": "#E11D48" },
				{ "slug": "accent-dark", "name": "Accent Dark", "color": "#881337" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"elements": {
			"h1": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"h2": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"h3": { "color": { "text": "var(--wp--preset--color--ink)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--accent) 85%, transparent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		},
		"blocks": {
			"core/button": {
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				":hover": {
					"color": {
						"background": "color-mix(in srgb, var(--wp--preset--color--accent) 85%, transparent)",
						"text": "var:preset|color|base"
					}
				}
			},
			"core/code": {
				"color": {
					"background": "var:preset|color|surface",
					"text": "var:preset|color|ink-2"
				}
			},
			"core/separator": {
				"color": { "text": "var:preset|color|rule" }
			}
		},
		"border": {
			"color": "var:preset|color|rule"
		}
	}
}
