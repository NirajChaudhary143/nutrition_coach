{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#0F172A"
        },
        {
          "slug": "ink-2",
          "name": "Ink Soft",
          "color": "#1E293B"
        },
        {
          "slug": "muted",
          "name": "Muted",
          "color": "#64748B"
        },
        {
          "slug": "rule",
          "name": "Rule",
          "color": "#E2E8F0"
        },
        {
          "slug": "surface",
          "name": "Surface",
          "color": "#F0FDF4"
        },
        {
          "slug": "base",
          "name": "Base",
          "color": "#FFFFFF"
        },
        {
          "slug": "accent",
          "name": "Accent",
          "color": "#16A34A"
        },
        {
          "slug": "accent-dark",
          "name": "Accent Dark",
          "color": "#14532D"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "Tiny",
          "size": "10px",
          "slug": "20"
        },
        {
          "name": "X-Small",
          "size": "20px",
          "slug": "30"
        },
        {
          "name": "Small",
          "size": "30px",
          "slug": "40"
        },
        {
          "name": "Regular",
          "size": "clamp(30px, 5vw, 50px)",
          "slug": "50"
        },
        {
          "name": "Large",
          "size": "clamp(30px, 7vw, 70px)",
          "slug": "60"
        },
        {
          "name": "X-Large",
          "size": "clamp(50px, 7vw, 90px)",
          "slug": "70"
        },
        {
          "name": "XX-Large",
          "size": "clamp(70px, 10vw, 140px)",
          "slug": "80"
        }
      ],
      "units": ["%", "px", "em", "rem", "vh", "vw"]
    },
    "typography": {
      "writingMode": true,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, system-ui, sans-serif"
        },
        {
          "slug": "inter-tight",
          "name": "Inter Tight",
          "fontFamily": "'Inter Tight', Inter, sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "small",
          "name": "Small",
          "size": "13px"
        },
        {
          "slug": "medium",
          "name": "Medium",
          "size": "15px"
        },
        {
          "slug": "large",
          "name": "Large",
          "size": "20px"
        },
        {
          "slug": "x-large",
          "name": "XL",
          "size": "32px"
        },
        {
          "slug": "xx-large",
          "name": "Display",
          "size": "48px"
        },
        {
          "slug": "xxx-large",
          "name": "Hero",
          "size": "80px"
        }
      ]
    },
    "custom": {
      "typography": {
        "line-height": {
          "tiny": "1.769",
          "small": "1.933",
          "base": "1.824",
          "large": "1.842",
          "minor": "1.625",
          "standard": "1.6",
          "medium": "1.313",
          "major": "1.238",
          "hero": "1.5",
          "button": "1.4"
        }
      },
      "spacing": {
        "gap": {
          "horizontal": "30px",
          "vertical": "30px"
        }
      }
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--base)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|40",
      "padding": {
        "left": "var:preset|spacing|50",
        "right": "var:preset|spacing|50"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "16px",
      "lineHeight": "1.55"
    },
    "blocks": {
      "core/avatar": {
        "border": {
          "radius": "100px"
        }
      },
      "core/button": {
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|base"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|inter",
          "fontSize": "14px",
          "fontWeight": "600",
          "lineHeight": "1.4",
          "textTransform": "none"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        },
        "border": {
          "radius": "8px"
        },
        ":hover": {
          "color": {
            "background": "color-mix(in srgb, var(--wp--preset--color--accent) 85%, transparent)",
            "text": "var:preset|color|base"
          }
        },
        "variations": {
          "outline": {
            "border": {
              "color": "currentColor",
              "width": "1px"
            },
            "spacing": {
              "padding": {
                "bottom": "calc(12px - 1px)",
                "left": "calc(24px - 1px)",
                "right": "calc(24px - 1px)",
                "top": "calc(12px - 1px)"
              }
            }
          }
        }
      },
      "core/buttons": {
        "spacing": {
          "blockGap": "12px"
        }
      },
      "core/columns": {
        "spacing": {
          "blockGap": "var:preset|spacing|50",
          "margin": {
            "top": "0",
            "bottom": "0",
            "left": "0",
            "right": "0"
          }
        }
      },
      "core/separator": {
        "border": {
          "color": "currentColor",
          "style": "solid",
          "width": "0 0 1px 0"
        },
        "color": {
          "text": "var:preset|color|rule"
        },
        "spacing": {
          "margin": {
            "top": "var:preset|spacing|50",
            "bottom": "var:preset|spacing|50"
          }
        }
      },
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        },
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/paragraph": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "var:custom|typography|line-height|base",
          "fontWeight": "400",
          "fontFamily": "var:preset|font-family|inter"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "var:preset|spacing|40"
          }
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "var:preset|spacing|40"
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            },
            "typography": {
              "textDecoration": "none"
            }
          }
        }
      },
      "core/site-title": {
        "typography": {
          "fontWeight": "700",
          "letterSpacing": "-.5px"
        },
        "elements": {
          "link": {
            "typography": {
              "textDecoration": "none"
            },
            ":hover": {
              "typography": {
                "textDecoration": "underline"
              }
            }
          }
        }
      },
      "core/list": {
        "css": "& li{margin-top: 0.5rem;}",
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "var:preset|spacing|40"
          },
          "padding": {
            "left": "var:preset|spacing|40"
          }
        }
      },
      "core/image": {
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "var:preset|spacing|50"
          }
        }
      },
      "core/quote": {
        "border": {
          "style": "solid",
          "width": "0 0 0 3px",
          "color": "var:preset|color|accent"
        },
        "spacing": {
          "blockGap": "var:preset|spacing|30",
          "margin": {
            "left": "0",
            "right": "0"
          },
          "padding": {
            "top": "var:preset|spacing|30",
            "right": "var:preset|spacing|40",
            "bottom": "var:preset|spacing|30",
            "left": "var:preset|spacing|40"
          }
        },
        "typography": {
          "fontSize": "var:preset|font-size|large",
          "fontWeight": "400"
        }
      },
      "core/search": {
        "css": "& .wp-block-search__input{border-radius:8px;padding-left:1rem;padding-right:1rem;border-color:var(--wp--preset--color--rule);}",
        "typography": {
          "fontSize": "var:preset|font-size|medium",
          "lineHeight": "1.6"
        }
      },
      "core/post-comments-form": {
        "css": "& textarea, input:not([type=submit]){border-radius:.25rem; border-color: var(--wp--preset--color--rule) !important;}",
        "typography": {
          "fontSize": "var:preset|font-size|medium"
        }
      }
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text": "var(--wp--preset--color--base)"
        },
        "border": {
          "radius": "8px"
        },
        "typography": {
          "fontWeight": "600",
          "fontSize": "14px"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "24px",
            "right": "24px"
          }
        }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter-tight)",
          "fontWeight": "700",
          "letterSpacing": "-0.03em",
          "lineHeight": "1.05"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter-tight)",
          "fontWeight": "700",
          "letterSpacing": "-0.025em"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontWeight": "600"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--accent)"
        }
      }
    },
    "border": {
      "color": "var:preset|color|rule"
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header",
      "title": "Header"
    },
    {
      "area": "footer",
      "name": "footer",
      "title": "Footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-no-title",
      "title": "Page No Title",
      "postTypes": ["page"]
    }
  ]
}
